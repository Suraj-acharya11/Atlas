NODE_ENV=development
PORT=3000
MONGO_URI=mongodb://localhost:27017/atlas
REDIS_URL=redis://localhost:6379
QDRANT_URL=http://localhost:6333
JWT_SECRET=replace-with-a-long-random-secret
